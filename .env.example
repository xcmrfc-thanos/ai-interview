# Copy to .env and set LLM_API_KEY. Do not commit the real key.
LLM_PROVIDER=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=THUDM/GLM-Z1-9B-0414
# 实时 Copilot 专用快模型（未配置时回落 LLM_MODEL；ark 回落 deepseek-v4-flash）
LLM_COPILOT_MODEL=

# ---- 火山引擎方舟（LLM_PROVIDER=ark）：配置统一走 LLM_*，仅换 base_url/key/model ----
# LLM_PROVIDER=ark
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# LLM_API_KEY=
# LLM_MODEL=                 # 通用模型（未填时默认 THUDM/GLM-Z1-9B-0414）
# LLM_COPILOT_MODEL=         # Copilot 快模型（未填时默认 deepseek-v4-flash）
LLM_TIMEOUT_SECONDS=45
APP_SECRET_KEY=replace-with-a-long-random-value
AI_INTERVIEW_DATABASE_URL=sqlite:///ai_interview_local.db
UPLOAD_DIR=uploads
MAX_CONTENT_LENGTH_MB=10
MICA_VOICE_ASR_URL=ws://127.0.0.1:18080/mica/voice/ws/online-asr
# ASR 后端选择（py 与 interview-server 共用）：gateway=强制走网关；builtin=强制进程内；auto=内置优先、缺失回退网关（默认）
ASR_BACKEND=auto
MICA_VOICE_MODELS_DIR=third_party/mica-voice/models
MICA_VOICE_ONLINE_MODEL=x-asr-zh-en-chunk-960ms
